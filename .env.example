# Postgres. Railway: reference the Postgres plugin's private URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Signs the access, refresh and collaboration tokens. 32+ random bytes:
#   openssl rand -base64 32
AUTH_SECRET=

# Public origin in production, e.g. https://daystream.up.railway.app
# AUTH_URL=https://daystream.up.railway.app

# Railway injects PORT. Optional local overrides:
# PORT=3000
# PGLITE_PORT=5432
# PREVIEW_HOSTNAME=example.style.dev

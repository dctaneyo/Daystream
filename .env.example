# Postgres connection string. On Railway: add the PostgreSQL plugin and reference
# its DATABASE_URL (private URL) on the Daystream service.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# 32+ byte random string: openssl rand -base64 32
# Railway: set it in the service Variables tab (or `railway variables --set`).
AUTH_SECRET=

# Public origin of the app.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Port the Node server listens on (Railway injects this automatically).
PORT=3000

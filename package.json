{
  "name": "daystream",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A calendar you can write in. Date-anchored notes, realtime, local-first.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "predev": "node scripts/gen-icons.mjs",
    "dev:db": "node scripts/dev-db.mjs",
    "prebuild": "node scripts/gen-icons.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node server/migrate.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.8.0",
    "@hocuspocus/server": "^4.8.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-collaboration": "^3.32.2",
    "@tiptap/extension-collaboration-caret": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-task-item": "^3.32.2",
    "@tiptap/extension-task-list": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
